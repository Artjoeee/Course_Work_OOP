<Window x:Class="Sportics.View.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Sportics.ViewModel"
        xmlns:helper="clr-namespace:Sportics.Helper"
        xmlns:local="clr-namespace:Sportics.View"
        mc:Ignorable="d"
        Title="Авторизация" Height="350" Width="400" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:AccountViewModel/>
    </Window.DataContext>

    <Grid Background="WhiteSmoke" Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Личный кабинет" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>

            <Button Content="Выйти" Height="35" Margin="0,15,0,0" Command="{Binding ExitCommand}" />
        </StackPanel>
    </Grid>
</Window>
